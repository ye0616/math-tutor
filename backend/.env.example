# 数学智教后端环境变量示例（CloudBase 云托管注入，切勿提交真实密钥）
# 复制为 .env 仅用于本地开发；部署时请在 CloudBase 控制台配置同名变量

# 智谱 GLM-4 大模型
ZHIPU_API_KEY=your_zhipu_key_here

# 数据库与上传目录（云托管持久卷挂载点，勿改路径）
DATABASE_PATH=/data/math_tutor.db
UPLOAD_DIR=/data/uploads

# 跨域：填前端静态托管域名（含 https://）
CORS_ORIGINS=https://math-tutor-xxxx.webapps.tcloudbase.com

# 认证密钥（生产请改掉默认值）
JWT_SECRET=change_me_to_a_random_secret

# 教师注册邀请码
TEACHER_INVITE_CODE=MATH2026

# 百度 OCR（可选，错题识别备用通道）
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
