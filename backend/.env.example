# 后端环境变量

# LLM - 智谱GLM-4（不填则走 Mock 模式，返回预设数据）
ZHIPU_API_KEY=

# 百度OCR（不填则跳过OCR功能）
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 数据库路径（云端部署时设为持久化存储路径）
# DATABASE_PATH=/app/data/math_tutor.db

# 文件上传目录
# UPLOAD_DIR=/app/uploads

# CORS 允许的前端地址（逗号分隔）
# 部署时设为你的 Vercel 域名，例如: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 端口（Railway/Render 会自动注入 PORT 变量）
# PORT=8000
